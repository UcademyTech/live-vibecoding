{
  "name": "live-vibecoding",
  "version": "1.0.0",
  "private": true,
  "description": "Repo base de la sesión de live vibecoding de Ucademy",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "npm run build:shared",
    "build:shared": "npm run build -w libs/shared",
    "predev": "npm run build:shared",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm run test:api && npm run test:web",
    "test:api": "npm run test -w apps/api",
    "test:web": "npm run test -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
